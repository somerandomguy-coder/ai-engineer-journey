{
    "permissions": {
        "allow": [
            "mcp__playwright"
        ],
        "deny": []
    },
    "hooks": {
        "PreToolUse": [
            {
                "matcher": "Read",
                "hooks": [
                    {
                        "type": "command",
                        "command": "node $PWD/hooks/read_hook.js"
                    }
                ]
            }
        ],
        "PostToolUse": [
            {
                "matcher": "Write|Edit|MultiEdit",
                "hooks": [
                    {
                        "type": "command",
                        "command": "node $PWD/hooks/type_check.js"
                    }
                ]
            }
        ]
    }
}